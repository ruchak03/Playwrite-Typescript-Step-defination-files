```typescript
// Scenario 10 - @TC10

When('User navigates to deal with one borrower and two facilities', async function () {
  await page.goto('/deal/one-borrower-two-facilities');
});

Then(
  'Borrower becomes {string} with Facilities {string} having amount {string} and {string} having amount {string}',
  async function (borrower, facility1, amount1, facility2, amount2) {
    const borrowerName = await page.locator('.borrower-name').textContent();
    expect(borrowerName?.trim()).toBe(borrower);

    const facility1Amount = await page.locator(`#${facility1}-amount`).textContent();
    const facility2Amount = await page.locator(`#${facility2}-amount`).textContent();

    expect(facility1Amount?.trim()).toBe(amount1);
    expect(facility2Amount?.trim()).toBe(amount2);
  }
);

Then('The deal page is loaded', async function () {
  await expect(page.locator('.deal-page')).toBeVisible();
});

When('User selects {string} and allocates it as {string}', async function (facility, borrower) {
  await page.click(`text=${facility}`);
  await page.click(`button:has-text("Allocate ${borrower}")`);
});

Then('{string} is successfully allocated to {string}', async function (borrower, facility) {
  const allocation = await page.locator(`#${facility}-allocation`).textContent();
  expect(allocation).toContain(borrower);
});

When(
  'User sets the limit for {string} for {string} as {string}',
  async function (borrower, facility, limit) {
    await page.fill(`#${facility}-${borrower}-limit`, limit);
    await page.click(`#${facility}-save`);
  }
);

Then(
  'The limit is set to {string} for {string} in {string}',
  async function (limit, borrower, facility) {
    const savedLimit = await page.locator(`#${facility}-${borrower}-limit`).inputValue();
    expect(savedLimit).toBe(limit);
  }
);

Then('Changes are saved', async function () {
  await expect(page.locator('.save-success')).toBeVisible();
});

When('User navigates to {string}', async function (facility) {
  await page.click(`text=${facility}`);
});

Then(
  'The {string} details are displayed and {string} is not yet allocated',
  async function (facility, borrower) {
    await expect(page.locator(`#${facility}-details`)).toBeVisible();

    const allocation = await page.locator(`#${facility}-allocation`).textContent();
    expect(allocation).not.toContain(borrower);
  }
);

When('User allocates {string} to {string}', async function (borrower, facility) {
  await page.click(`button:has-text("Allocate ${borrower}")`);
});

Then(
  'The limit field for {string} in {string} is empty or zero',
  async function (borrower, facility) {
    const limitValue = await page
      .locator(`#${facility}-${borrower}-limit`)
      .inputValue();

    expect(limitValue === '' || limitValue === '0').toBeTruthy();
  }
);

When(
  'User sets the limit as {string} for {string} in {string}',
  async function (limit, borrower, facility) {
    await page.fill(`#${facility}-${borrower}-limit`, limit);
    await page.click(`#${facility}-save`);
  }
);

When('User navigates back to {string}', async function (facility) {
  await page.click(`text=${facility}`);
});

Then('The view for {string} is displayed', async function (facility) {
  await expect(page.locator(`#${facility}-details`)).toBeVisible();
});

Then(
  'The limit for {string} is shown as {string}',
  async function (borrower, limit) {
    const savedLimit = await page
      .locator(`.limit-display:has-text("${borrower}")`)
      .textContent();

    expect(savedLimit).toContain(limit);
  }
);
